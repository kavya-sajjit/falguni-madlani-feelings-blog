---
/**
 * A toran: the string of marigolds and mango leaves hung over an Indian doorway.
 * It hangs across the top of every page; on the home page the flowers settle in once.
 */
interface Props { animate?: boolean }
const { animate = false } = Astro.props;

const W = 1200, SAG = 18, TOP = 6;
const yAt = (x: number) => TOP + SAG * (1 - ((2 * x) / W - 1) ** 2); // parabola
const f = (n: number) => n.toFixed(1);
const items: { x: number; y: number; kind: "flower" | "leaf"; tilt: number; i: number }[] = [];
const step = 34;
let i = 0;
for (let x = step / 2; x < W; x += step, i++) {
  const slope = (-SAG * 2 * ((2 * x) / W - 1) * 2) / W;          // dy/dx of the string
  items.push({ x, y: yAt(x), kind: i % 3 === 1 ? "leaf" : "flower", tilt: Math.atan(slope) * 57.3 * 0.6 + ((i * 37) % 7) - 3, i });
}
const string = `M0,${f(yAt(0))} Q${W / 2},${f(TOP + SAG * 2)} ${W},${f(yAt(W))}`;
---
<div class:list={["toran", { "toran--settle": animate }]} aria-hidden="true">
  <svg viewBox={`0 0 ${W} 74`} preserveAspectRatio="xMidYMin slice" focusable="false">
    <path class="toran__string" d={string} />
    {items.map((it) => (
      <g transform={`translate(${f(it.x)} ${f(it.y)}) rotate(${f(it.tilt)})`}>
        <g class="toran__item" style={`--d:${(0.15 + Math.abs(it.x - W / 2) / W * 0.9).toFixed(2)}s`}>
          {it.kind === "leaf" ? (
            <>
              <path class="toran__leaf" d="M0,0 C9,10 9,30 0,44 C-9,30 -9,10 0,0 Z" />
              <path class="toran__vein" d="M0,3 L0,40" />
            </>
          ) : (
            <>
              <line class="toran__thread" x1="0" y1="0" x2="0" y2={it.i % 2 ? 10 : 6} />
              <g transform={`translate(0 ${it.i % 2 ? 19 : 15})`}>
                {Array.from({ length: 11 }, (_, k) => (
                  <circle class="toran__petal-back" r="3.9" cx={f(Math.cos(k * 0.571 + it.i) * 8)} cy={f(Math.sin(k * 0.571 + it.i) * 8)} />
                ))}
                {Array.from({ length: 8 }, (_, k) => (
                  <circle class="toran__petal" r="3.6" cx={f(Math.cos(k * 0.785 + it.i * 0.5) * 4.6)} cy={f(Math.sin(k * 0.785 + it.i * 0.5) * 4.6)} />
                ))}
                <circle class="toran__heart" r="2.6" />
              </g>
            </>
          )}
        </g>
      </g>
    ))}
  </svg>
</div>

<style>
  .toran { height: 74px; overflow: hidden; pointer-events: none; }
  .toran svg { width: 100%; height: 74px; display: block; }
  .toran__string { fill: none; stroke: #8a6a3a; stroke-width: 1.4; }
  .toran__thread { stroke: #8a6a3a; stroke-width: 1; }
  .toran__leaf { fill: var(--leaf); }
  .toran__vein { stroke: #9bb06f; stroke-width: 1; }
  .toran__petal-back { fill: #e08a14; stroke: #c9740c; stroke-width: 0.6; }
  .toran__petal { fill: #f2b141; stroke: #e39a26; stroke-width: 0.5; }
  .toran__heart { fill: #a85a08; }

  @media (prefers-reduced-motion: no-preference) {
    .toran--settle .toran__item {
      opacity: 0;
      transform: translateY(-14px) rotate(-6deg);
      transform-origin: 0 0;
      animation: settle 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
      animation-delay: var(--d);
    }
  }
  @keyframes settle { to { opacity: 1; transform: none; } }
</style>
