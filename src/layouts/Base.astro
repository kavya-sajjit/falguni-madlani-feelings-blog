---
import "../styles/global.css";
import { SITE, url } from "../site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: { published: Date };
}
const { title, description = SITE.description, image, article } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.fullTitle}` : `${SITE.fullTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? url("og.png"), Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: url("/"), label: "Writing" },
  { href: url("archive/"), label: "Archive" },
  { href: url("about/"), label: "About" },
];

const ld = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      datePublished: article.published.toISOString(),
      author: { "@type": "Person", name: SITE.author, url: new URL(url("about/"), Astro.site).href },
      mainEntityOfPage: canonical.href,
      image: ogImage.href,
    }
  : {
      "@context": "https://schema.org",
      "@type": "Blog",
      name: SITE.fullTitle,
      url: new URL(url("/"), Astro.site).href,
      description: SITE.description,
      author: { "@type": "Person", name: SITE.author },
    };
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.fullTitle} href={url("rss.xml")} />
    <link rel="sitemap" href={url("sitemap-index.xml")} />
    <meta name="theme-color" content="#edefe7" />

    <meta property="og:site_name" content={SITE.fullTitle} />
    <meta property="og:title" content={title ?? SITE.fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head wrap">
      <a class="site-name" href={url("/")}>Falguni Madlani</a>
      <nav aria-label="Main">
        {nav.map((n) => (
          <a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot wrap">
      <p>© {new Date().getFullYear()} Falguni Madlani. Words and photographs are hers; please ask before reusing them.</p>
      <p><a href={url("rss.xml")}>Follow by RSS</a></p>
    </footer>
  </body>
</html>

<style>
  .site-head {
    display: flex; flex-wrap: wrap; gap: 0.5rem 2rem;
    align-items: baseline; justify-content: space-between;
    padding-block: 1.75rem 0;
  }
  .site-name {
    font-family: var(--serif-display); font-size: 1.15rem;
    color: var(--ink); text-decoration: none;
  }
  nav { display: flex; gap: 1.5rem; }
  nav a { color: var(--fern); text-decoration: none; font-size: var(--step--1); }
  nav a:hover, nav a[aria-current="page"] { color: var(--ink); text-decoration: underline; text-decoration-color: var(--rule); }
  main { padding-bottom: 5rem; }
  .site-foot {
    border-top: 1px solid var(--rule);
    padding-block: 1.5rem 2.5rem;
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem;
    font-size: var(--step--1); color: var(--fern);
  }
  .site-foot p { margin: 0; max-width: 36rem; }
  .site-foot a { color: var(--fern); }
</style>
