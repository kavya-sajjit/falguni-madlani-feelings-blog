---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { url, allLabels, slugify } from "../../site";
const posts = await getCollection("posts", (p) => !p.data.draft);
const labels = allLabels(posts);
---
<Base title="Topics" description="Posts on Feelings by Falguni Madlani, grouped by topic.">
  <div class="wrap page">
    <h1>Topics</h1>
    {labels.length ? (
      <ul>
        {labels.map(([l, n]) => (
          <li><a href={url(`topics/${slugify(l)}/`)}>{l}</a> <span>{n} {n === 1 ? "post" : "posts"}</span></li>
        ))}
      </ul>
    ) : (
      <p class="none">Posts haven't been given topics yet. Every post is in the <a href={url("archive/")}>archive</a>.</p>
    )}
  </div>
</Base>
<style>
  .page { padding-top: clamp(2rem, 6vw, 4rem); padding-left: 11.5rem; }
  h1 { font-size: var(--step-3); margin-bottom: 1.5rem; }
  ul { list-style: none; padding: 0; margin: 0; columns: 2 16rem; column-gap: 3rem; }
  li { padding: 0.35rem 0; break-inside: avoid; }
  a { font-family: var(--serif-display); font-size: var(--step-1); color: var(--ink); text-decoration: none; }
  a:hover { color: var(--clay); }
  span { color: var(--fern); font-size: var(--step--1); margin-left: 0.4rem; }
  .none a { font: inherit; color: var(--clay); text-decoration: underline; }
  @media (max-width: 44rem) { .page { padding-left: 0; } }
</style>
