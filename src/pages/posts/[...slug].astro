---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Fern from "../../components/Fern.astro";
import { url, fmtDate, excerpt } from "../../site";

export async function getStaticPaths() {
  const posts = (await getCollection("posts", (p) => !p.data.draft))
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i - 1], next: posts[i + 1] },
  }));
}
const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const description = post.data.description ?? excerpt(post.body, 28);
---
<Base title={post.data.title} description={description} image={post.data.cover ?? post.data.image} article={{ published: post.data.date }}>
  <article class="wrap post">
    <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
    <div class="body">
      <h1>{post.data.title}</h1>
      {post.data.cover && <img class="cover" src={post.data.cover} alt={post.data.coverAlt ?? ""} />}
      <div class="prose"><Content /></div>
      <div class="sign"><Fern /></div>
    </div>
  </article>

  <nav class="wrap pager" aria-label="More posts">
    {prev ? <a href={url(`posts/${prev.id}/`)} rel="prev"><span>Earlier</span>{prev.data.title}</a> : <span />}
    {next ? <a href={url(`posts/${next.id}/`)} rel="next" class="next"><span>Later</span>{next.data.title}</a> : <span />}
  </nav>
</Base>

<style>
  .post {
    padding-top: clamp(2.5rem, 7vw, 5rem);
    display: grid; grid-template-columns: 9.5rem minmax(0, 44rem); gap: 0.5rem 2rem;
  }
  time { color: var(--fern); font-size: var(--step--1); padding-top: 0.9rem; }
  h1 { font-size: var(--step-3); margin-bottom: 2.25rem; text-wrap: balance; }
  .cover { max-width: 44rem; width: 100%; margin-bottom: 2.25rem; border-radius: 3px; }
  .sign { width: 2.2rem; margin-top: 3rem; opacity: 0.8; }
  .pager {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; padding-left: 11.5rem;
    margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--rule);
  }
  .pager a { color: var(--ink); text-decoration: none; font-family: var(--serif-display); font-size: var(--step-1); line-height: 1.3; }
  .pager a:hover { color: var(--mulberry); }
  .pager span { display: block; font-family: var(--serif); font-style: italic; font-size: var(--step--1); color: var(--fern); margin-bottom: 0.25rem; }
  .pager .next { text-align: right; }
  @media (max-width: 44rem) {
    .post { grid-template-columns: 1fr; }
    time { padding-top: 0; }
    .pager { padding-left: 0; }
  }
</style>
