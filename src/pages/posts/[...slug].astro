---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Share from "../../components/Share.astro";
import { url, fmtDate, excerpt, readingTime, slugify } from "../../site";

export async function getStaticPaths() {
  const posts = (await getCollection("posts", (p) => !p.data.draft))
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return posts.map((post, i) => {
    // Related: posts sharing a label first, then the nearest in time.
    const others = posts.filter((p) => p.id !== post.id);
    const shared = (p: any) => p.data.labels.filter((l: string) => post.data.labels.includes(l)).length;
    const dist = (p: any) => Math.abs(p.data.date.valueOf() - post.data.date.valueOf());
    const related = others.sort((a, b) => shared(b) - shared(a) || dist(a) - dist(b)).slice(0, 3);
    return { params: { slug: post.id }, props: { post, prev: posts[i - 1], next: posts[i + 1], related } };
  });
}
const { post, prev, next, related } = Astro.props;
const { Content } = await render(post);
const description = post.data.description ?? excerpt(post.body, 28);
// Many imported posts already end with "By Falguni Madlani"; don't sign twice.
const signed = /by\s+falguni/i.test(post.body.replace(/<[^>]+>/g, " ").trim().slice(-200));
const href = new URL(url(`posts/${post.id}/`), Astro.site).href;
---
<Base title={post.data.title} description={description} image={post.data.cover ?? post.data.image} article={{ published: post.data.date }}>
  <article class="wrap post">
    <aside class="meta">
      <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
      <span>{readingTime(post.body)}</span>
      {post.data.labels.length > 0 && (
        <ul class="labels" aria-label="Topics">
          {post.data.labels.map((l) => <li><a href={url(`topics/${slugify(l)}/`)}>{l}</a></li>)}
        </ul>
      )}
    </aside>
    <div class="body" data-pagefind-body>
      <h1>{post.data.title}</h1>
      {post.data.cover && <img class="cover" src={post.data.cover} alt={post.data.coverAlt ?? ""} />}
      <div class="prose"><Content /></div>
      {!signed && <p class="hand sign" data-pagefind-ignore>~ Falguni</p>}
      <div data-pagefind-ignore><Share title={post.data.title} href={href} /></div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="wrap related" aria-labelledby="related">
      <h2 id="related">You might also like</h2>
      <ul>
        {related.map((r) => (
          <li><a href={url(`posts/${r.id}/`)}>{r.data.title}</a><span>{fmtDate(r.data.date)}</span></li>
        ))}
      </ul>
    </section>
  )}

  <nav class="wrap pager" aria-label="Older and newer posts">
    {prev ? <a href={url(`posts/${prev.id}/`)} rel="prev"><span>Older</span>{prev.data.title}</a> : <span />}
    {next ? <a href={url(`posts/${next.id}/`)} rel="next" class="next"><span>Newer</span>{next.data.title}</a> : <span />}
  </nav>
</Base>

<style>
  .post {
    padding-top: clamp(2rem, 6vw, 4rem);
    display: grid; grid-template-columns: 9.5rem minmax(0, 44rem); gap: 0.5rem 2rem;
  }
  .meta { display: flex; flex-direction: column; gap: 0.2rem; padding-top: 0.9rem; font-size: var(--step--1); color: var(--fern); }
  .labels { list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; flex-direction: column; gap: 0.2rem; }
  .labels a { color: var(--clay); }
  h1 { font-size: var(--step-3); margin-bottom: 2.25rem; text-wrap: balance; }
  .cover { width: 100%; margin-bottom: 2.25rem; border-radius: 4px; }
  .sign { font-size: 1.6rem; margin: 2rem 0 0; transform: rotate(-2deg); transform-origin: left; }

  .related { margin-top: 3.5rem; padding-left: 11.5rem; }
  .related h2 { font-family: var(--serif); font-style: italic; font-size: var(--step--1); color: var(--fern); }
  .related ul { list-style: none; padding: 0; margin: 0.75rem 0 0; display: grid; gap: 0.75rem; }
  .related a { font-family: var(--serif-display); font-size: var(--step-1); color: var(--ink); text-decoration: none; margin-right: 0.75rem; }
  .related a:hover { color: var(--clay); }
  .related span { font-size: var(--step--1); color: var(--fern); white-space: nowrap; }

  .pager {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; padding-left: 11.5rem;
    margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--rule);
  }
  .pager a { color: var(--ink); text-decoration: none; font-family: var(--serif-display); font-size: var(--step-1); line-height: 1.3; }
  .pager a:hover { color: var(--clay); }
  .pager span { display: block; font-family: var(--serif); font-style: italic; font-size: var(--step--1); color: var(--fern); margin-bottom: 0.25rem; }
  .pager .next { text-align: right; }
  @media (max-width: 44rem) {
    .post { grid-template-columns: 1fr; }
    .meta { flex-direction: row; flex-wrap: wrap; gap: 0.2rem 1rem; padding-top: 0; }
    .labels { flex-direction: row; margin: 0; gap: 0.2rem 0.75rem; }
    .related, .pager { padding-left: 0; }
  }
</style>
