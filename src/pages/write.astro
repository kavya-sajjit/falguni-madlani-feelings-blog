---
import Base from "../layouts/Base.astro";
import { EDITOR_URL } from "../site";
---
<Base title="Write a post" noindex>
  <div class="wrap page">
    <p class="hand hello">Hello Falguni!</p>
    <h1>Write a new post</h1>
    <ol class="steps">
      <li>Press the button below. The first time, sign in with your email and open the link it sends you.</li>
      <li>Choose <strong>Add an entry</strong>. Write a title and your post, and add a photo if you like.</li>
      <li>Press <strong>Save</strong>. Your post appears on the blog in about two minutes.</li>
    </ol>
    <p><a class="go" href={EDITOR_URL}>Open my writing desk</a></p>
    <p class="tip">Tip: bookmark this page, or add it to your phone's home screen, so it's always one tap away.
    To keep something unfinished private, tick <strong>Save as draft</strong> before saving.</p>
  </div>
</Base>
<style>
  .page { padding-top: clamp(2rem, 6vw, 4rem); max-width: 40rem; }
  .hello { font-size: 1.8rem; margin: 0; transform: rotate(-2deg); transform-origin: left; }
  h1 { font-size: var(--step-3); margin: 0.25rem 0 1.5rem; }
  .steps { padding-left: 1.2rem; display: grid; gap: 0.75rem; }
  .go {
    display: inline-block; margin-top: 1rem; padding: 0.85rem 1.4rem; border-radius: 999px;
    background: var(--leaf); color: #fff; text-decoration: none; font-size: var(--step-1);
  }
  .go:hover { background: var(--moss); }
  .tip { color: var(--fern); margin-top: 2rem; font-size: var(--step--1); }
</style>
